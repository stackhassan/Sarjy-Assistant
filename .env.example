# Required — https://console.groq.com/keys
GROQ_API_KEY=

# Optional — fallback LLM provider — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Memory — Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — signs screened sentences for /api/tts (derived from GROQ_API_KEY if unset)
TTS_SIGNING_SECRET=

# Optional — honour the guard_down fault flag in production (off by default: it weakens guardrails)
CHAOS_ALLOW_GUARD_FAULTS=
