# Required — https://console.groq.com/keys
GROQ_API_KEY=

# Optional — fallback LLM provider — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Memory — Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — signs screened sentences for /api/tts (derived from GROQ_API_KEY if unset)
TTS_SIGNING_SECRET=

# Optional — honour the guard_down fault flag in production (off by default: it weakens guardrails)
CHAOS_ALLOW_GUARD_FAULTS=

# What happens when a guard model is unavailable: fail_closed (default; use in production)
# or restricted (development only: rule-based backups, risky-looking sentences blocked)
GUARD_DEGRADED_POLICY=

# Show guard internals (Guardrail Inspector) in the browser. Defaults to on in development,
# off in production. Set to 1 on the public demo if reviewers should see the Inspector.
NEXT_PUBLIC_SARJY_DEMO_MODE=

# Optional backup providers (both OpenAI-compatible)
# SambaNova: gpt-oss-120b on another provider; free tier has a small daily cap, so it's
# used only when Groq fails. https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
# Mistral: backup chat model and independent guard backup. https://console.mistral.ai
MISTRAL_API_KEY=
